[Unit]
Description=PatchPanel Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind address and tokens come from the environment file, so changing the port
# does not mean editing a unit file.
ExecStart=/usr/local/bin/pp-portal --db /var/lib/patchpanel-portal/portal.db

# The portal needs no privileges: it talks to agents and to SQLite, nothing else.
User=patchpanel
Group=patchpanel
DynamicUser=no

Restart=always
RestartSec=5s

StateDirectory=patchpanel-portal

# Tokens belong in this file, not on a command line where `ps` shows them.
# Create it with mode 0600, containing:
#   PATCHPANEL_ADMIN_TOKEN=...
#   PATCHPANEL_ENROLLMENT_TOKEN=...
EnvironmentFile=/etc/patchpanel/portal.env

# Port 80 is privileged, but nothing else here needs root. Grant exactly the
# one capability that binding it requires and drop the rest, rather than
# running the whole service as root or setcap-ing a binary that self-updates.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/patchpanel-portal

StandardOutput=journal
StandardError=journal
SyslogIdentifier=patchpanel-portal

[Install]
WantedBy=multi-user.target
