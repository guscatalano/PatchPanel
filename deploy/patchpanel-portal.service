[Unit]
Description=PatchPanel Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pp-portal --bind 0.0.0.0:8080 --db /var/lib/patchpanel-portal/portal.db

# The portal needs no privileges: it talks to agents and to SQLite, nothing else.
User=patchpanel
Group=patchpanel
DynamicUser=no

Restart=always
RestartSec=5s

StateDirectory=patchpanel-portal

# Tokens belong in this file, not on a command line where `ps` shows them.
# Create it with mode 0600, containing:
#   PATCHPANEL_ADMIN_TOKEN=...
#   PATCHPANEL_ENROLLMENT_TOKEN=...
EnvironmentFile=/etc/patchpanel/portal.env

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/patchpanel-portal

StandardOutput=journal
StandardError=journal
SyslogIdentifier=patchpanel-portal

[Install]
WantedBy=multi-user.target
