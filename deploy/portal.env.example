# Copy to /etc/patchpanel/portal.env, chmod 600.
# Without these the portal generates fresh tokens on every restart, which
# invalidates the dashboard session and blocks new enrollments.
PATCHPANEL_ADMIN_TOKEN=change-me-64-random-hex-characters
PATCHPANEL_ENROLLMENT_TOKEN=change-me-a-different-secret
PATCHPANEL_LOG=info

# Listen address. Port 80 needs CAP_NET_BIND_SERVICE, which the shipped unit
# grants; anything above 1024 needs nothing special.
PATCHPANEL_BIND=0.0.0.0:80
